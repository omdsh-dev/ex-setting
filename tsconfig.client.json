{
  "compilerOptions": {
    "target": "es2024",
    "module": "esnext",
    "moduleResolution": "bundler",
    "declaration": true,
    "sourceMap": true,
    "declarationMap": true,
    "composite": true,
    "incremental": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "verbatimModuleSyntax": false,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "jsx": "react-jsx",
    "lib": [
      "ES2024",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [],
    "baseUrl": ".",
    "ignoreDeprecations": "6.0",
    "rootDir": "src",
    "outDir": "lib/types",
    "tsBuildInfoFile": "lib/tsconfig.client.tsbuildinfo",
    "paths": {
      "@deepseek-ai/dsh-ex-setting": [
        "src/index.ts"
      ],
      "@deepseek-ai/dsh-ex-setting/*": [
        "src/*"
      ],
      "@deepseek-ai/dsh-api-remotes/client": [
        "../deepseek-harness/packages/api/remotes/src/client/index.ts"
      ],
      "@deepseek-ai/dsh-client-connection/client": [
        "../deepseek-harness/packages/client/connection/src/client/index.ts"
      ],
      "@deepseek-ai/dsh-client-locale/client": [
        "../deepseek-harness/packages/client/locale/src/client/index.ts"
      ],
      "@deepseek-ai/dsh-client-runtime/client": [
        "../deepseek-harness/packages/client/runtime/src/client/index.ts"
      ],
      "@deepseek-ai/dsh-client-schema-form": [
        "../deepseek-harness/packages/client/schema-form/src/index.ts"
      ],
      "@deepseek-ai/dsh-client-test-runtime": [
        "../deepseek-harness/packages/test-support/client-runtime/src/index.ts"
      ],
      "@deepseek-ai/dsh-client-ui-settings/client": [
        "../deepseek-harness/packages/client/ui-settings/src/client/index.ts"
      ],
      "@deepseek-ai/dsh-client-ui-slots": [
        "../deepseek-harness/packages/client/ui-slots/src/index.ts"
      ],
      "@deepseek-ai/dsh-invariants": [
        "../deepseek-harness/packages/runtime-diagnostics/invariants/src/index.ts"
      ],
      "cordis": [
        "../deepseek-harness/vendor/cordis/src"
      ],
      "@deepseek-ai/cordis": [
        "../deepseek-harness/vendor/cordis/src"
      ],
      "@deepseek-ai/schemastery": [
        "../deepseek-harness/vendor/schemastery/src"
      ],
      "@deepseek-ai/cordis-plugin-loader": [
        "../deepseek-harness/vendor/loader/src"
      ],
      "cordis-fabric": [
        "./node_modules/cordis-fabric/src/index.ts"
      ],
      "cordis-fabric/client": [
        "./node_modules/cordis-fabric/src/client/index.ts"
      ],
      "cordis-fabric-api": [
        "./node_modules/cordis-fabric-api/src/index.ts"
      ],
      "cordis-fabric-api/compat": [
        "./node_modules/cordis-fabric-api/src/compat.ts"
      ],
      "module-details-from-path": [
        "./types/module-details-from-path.d.ts"
      ]
    }
  },
  "include": [
    "src/client",
    "src/css-modules.d.ts"
  ],
  "references": [
    {
      "path": "../deepseek-harness/vendor/cordis"
    },
    {
      "path": "../deepseek-harness/packages/runtime-diagnostics/invariants"
    },
    {
      "path": "../deepseek-harness/packages/api/remotes/tsconfig.client.json"
    },
    {
      "path": "../deepseek-harness/packages/client/connection/tsconfig.client.json"
    },
    {
      "path": "../deepseek-harness/packages/client/locale"
    },
    {
      "path": "../deepseek-harness/packages/client/runtime"
    },
    {
      "path": "../deepseek-harness/packages/client/schema-form"
    },
    {
      "path": "../deepseek-harness/packages/client/ui-settings"
    },
    {
      "path": "../deepseek-harness/packages/client/ui-slots"
    }
  ]
}
