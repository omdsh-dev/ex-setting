index 0000000000000000000000000000000000000000..09119fec5a1ec36cd3762126a78e5099efd9d3e6
--- /dev/null
+++ b/packages/host/apiproxy/src/api/composition.schema.ts
@@ -0,0 +1,56 @@
+/**
+ * composition domain zod schemas (names derived from map keys:
+ * compositionDescribeRequestSchema / compositionDescribeValueSchema /
+ * compositionUpdate* / compositionRemove*).
+ */
+
+import { z } from 'zod'
+import type { RequestPayload, ResponseValue } from './rpc-map.ts'
+import type { Wire } from './rpc.schema.ts'
+import type { CompositionNamespaceView, CompositionSecretView } from './composition.ts'
+
+/** One redacted secret slot. */
+export const compositionSecretViewSchema = z.object({
+  path: z.array(z.string()),
+  set: z.boolean(),
+}) satisfies z.ZodType<Wire<CompositionSecretView>>
+
+/** CompositionNamespaceView row of composition.describe and the write response. */
+export const compositionNamespaceViewSchema = z.object({
+  id: z.string().min(1),
+  name: z.string().optional(),
+  schema: z.unknown(),
+  value: z.unknown(),
+  secrets: z.array(compositionSecretViewSchema),
+}) satisfies z.ZodType<Wire<CompositionNamespaceView>>
+
+/** composition.describe request payload. */
+export const compositionDescribeRequestSchema = z.object({}) satisfies z.ZodType<Wire<RequestPayload<'composition.describe'>>>
+
+/** composition.describe response value. */
+export const compositionDescribeValueSchema = z.object({
+  namespaces: z.array(compositionNamespaceViewSchema),
+}) satisfies z.ZodType<Wire<ResponseValue<'composition.describe'>>>
+
+/** One path-addressed edit of composition.update. */
+export const compositionPathOpSchema = z.discriminatedUnion('op', [
+  z.object({ op: z.literal('set'), path: z.array(z.string()), value: z.unknown() }),
+  z.object({ op: z.literal('unset'), path: z.array(z.string()) }),
+])
+
+/** composition.update request payload. */
+export const compositionUpdateRequestSchema = z.object({
+  id: z.string().min(1),
+  ops: z.array(compositionPathOpSchema),
+}) satisfies z.ZodType<Wire<RequestPayload<'composition.update'>>>
+
+/** composition.update response value: the row's new redacted view. */
+export const compositionUpdateValueSchema = compositionNamespaceViewSchema satisfies z.ZodType<Wire<ResponseValue<'composition.update'>>>
+
+/** composition.remove request payload. */
+export const compositionRemoveRequestSchema = z.object({
+  id: z.string().min(1),
+}) satisfies z.ZodType<Wire<RequestPayload<'composition.remove'>>>
+
+/** composition.remove response value. */
+export const compositionRemoveValueSchema = z.object({}) satisfies z.ZodType<Wire<ResponseValue<'composition.remove'>>>
