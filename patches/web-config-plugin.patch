diff --git a/apps/web/tests/settings-chrome.e2e.ts b/apps/web/tests/settings-chrome.e2e.ts
index 19e1b33538d6cdb201fa953e9e8b20ebfc135552..ad9f34fbea3a0e1d35d6aceeabf2d182ba0c5a3e 100644
--- a/apps/web/tests/settings-chrome.e2e.ts
+++ b/apps/web/tests/settings-chrome.e2e.ts
@@ -64,6 +64,22 @@ describe('web e2e: settings modal and General preferences', () => {
     // Golden of the freshly opened dialog (default zh, General active).
     const snapshot = await captureStableAria(page, '[role="dialog"]', scaffold.workspaceCwd)
     await compareOrRefreshGolden(DIALOG_EXPECTED, snapshot, MODE)
+    // Automatically crawled Settings and Config sources occupy distinct
+    // first-level rows even when their source ids match.
+    const deepseek = dialog.getByRole('button', { name: 'llm-deepseek', exact: true })
+    expect(await deepseek.count()).toBe(1)
+    await deepseek.click()
+    await dialog.getByRole('heading', { name: 'llm-deepseek', exact: true }).waitFor({ timeout: 10_000 })
+    expect(await deepseek.getAttribute('aria-current')).toBe('true')
+    const deepseekConfig = dialog.getByRole('button', { name: 'llm-deepseek · Config', exact: true })
+    await deepseekConfig.click()
+    await dialog.getByRole('heading', { name: 'llm-deepseek · Config', exact: true }).waitFor({ timeout: 10_000 })
+    expect(await deepseekConfig.getAttribute('aria-current')).toBe('true')
+    // The long automatic catalog remains scrollable through its final row.
+    const catalogTail = dialog.getByRole('button', { name: 'workspace-context', exact: true })
+    await catalogTail.click()
+    await dialog.getByRole('heading', { name: 'workspace-context', exact: true }).waitFor({ timeout: 10_000 })
+    expect(await catalogTail.getAttribute('aria-current')).toBe('true')
     // Section switch: aria-current moves (the Models page itself has its own scenario file).
     await dialog.getByRole('button', { name: '模型' }).click()
     await expect.poll(() => dialog.getByRole('button', { name: '模型' }).getAttribute('aria-current'), { timeout: 5_000 }).toBe('true')
