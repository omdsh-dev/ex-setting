index 0000000000000000000000000000000000000000..4b20f53800082eb02e1751a95376d8afedc5c086
--- /dev/null
+++ b/packages/host/apiproxy/src/api/composition.ts
@@ -0,0 +1,62 @@
+/**
+ * composition domain contract: the web face of mounted plugins' cordis.yml
+ * row configuration, crawled by the web-config-crawler plugin. Every payload
+ * that leaves this domain is redacted by the crawler with the same structural
+ * walk the settings seam uses: `role('secret')` fields never ride a response,
+ * and the `secrets` slot list is how a form learns a write-only field exists.
+ * Writes are path-addressed ops applied host-side against the CURRENT resolved
+ * configuration, so a secret the wire never returned survives an edit; the
+ * full row is then persisted into the personal config overlay and takes
+ * effect on the next boot.
+ */
+
+import type { RpcRequest, RpcResponse } from './rpc.ts'
+
+/** One schema-declared secret slot inside a redacted composition value. */
+export interface CompositionSecretView {
+  /** Path from the row root to the removed field. */
+  path: string[]
+  /** Whether the slot currently holds a value (the value itself never rides). */
+  set: boolean
+}
+
+/** Wire view of one mounted plugin's composition configuration. */
+export interface CompositionNamespaceView {
+  /** Composition row id (`llm-deepseek`, `session`, …). */
+  id: string
+  /** Optional display name from the plugin shape. */
+  name?: string
+  /** Serialized schemastery schema envelope (`Config.toJSON()`). */
+  schema: unknown
+  /** Redacted resolved configuration (row config after defaulting). */
+  value: unknown
+  /** Every schema-declared secret slot with its configured state. */
+  secrets: CompositionSecretView[]
+}
+
+/** Composition-domain unary methods (the map keys composition.* of RpcMethodMap). */
+export interface CompositionApi {
+  /**
+   * Describe every mounted plugin whose composition row carries a `Config`
+   * schema, redacted. Absent without the web-config-crawler plugin.
+   */
+  describe(request: RpcRequest<{}>): Promise<RpcResponse<{ namespaces: CompositionNamespaceView[] }>>
+
+  /**
+   * Apply path-addressed edits to one mounted plugin's resolved composition
+   * configuration and persist the full row into the personal overlay. Ops are
+   * resolved against the configuration as it stands when the write runs, so a
+   * client holding a redacted view never deletes a secret it did not receive;
+   * the empty path addresses the row root. A schema or storage rejection is
+   * `composition-rejected`; an unknown row is `composition-not-found`.
+   */
+  update(
+    request: RpcRequest<{ id: string; ops: Array<{ op: 'set'; path: string[]; value: unknown } | { op: 'unset'; path: string[] }> }>,
+  ): Promise<RpcResponse<CompositionNamespaceView>>
+
+  /**
+   * Remove one mounted plugin's row from the personal overlay, reverting it
+   * to the lower composition layers on the next boot.
+   */
+  remove(request: RpcRequest<{ id: string }>): Promise<RpcResponse<{}>>
+}
